<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SciFac Events</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
</head>

<body>
    <header class="main-header">
        <div class="container">
            <div class="title">
                <h1 class="title">SciFac Events</h1>
            </div>

            <nav class="main-nav">
                <ul>
                    <li></li>
                    <li></li>
                    <li><a href="/">Home</a></li>
                    <li><a href="/events">Events</a></li>
                    <li><a href="/venues">Venues</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

        <div class="container" mb-10>
            <h1 class="form-title">Create New Venue</h1>

            <!-- =================== Venue Form =================== -->
            <div class="form-container">
                <form action="/venue/add" method="POST">
                    <div class="form-group.full-width">
                        <label for="venueName" class="col-sm-2 col-form-label">Name<span
                                class="required">*</span></label>
                        <input type="text" class="form-control" id="venueName" name="venueName" required>
                        <br>
                    </div>
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label for="venueLocation" class="col-sm-5 col-form-label">Location<span
                                    class="required">*</span></label>
                            <input type="text" class="form-control" id="venueLocation" name="venueLocation" required>
                            <br>
                        </div>

                        <div class="form-group">
                            <label for="venueCapacity" class="col-sm-5 col-form-label">Capacity<span
                                    class="required">*</span></label>
                            <input type="number" class="form-control" id="venueCapacity" name="venueCapacity" required>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save Venue</button>
                        <button type="button" class="btn btn-secondary"><a href="/venues">Cancel</a></button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>

</html>